<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:IndustrialDataAnalyzer.App.Controls">
  <Style TargetType="{x:Type controls:MetricCard}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:MetricCard}">
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="18" MinHeight="108">
            <StackPanel>
              <TextBlock Text="{TemplateBinding Title}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
              <TextBlock Text="{TemplateBinding Value}" Foreground="{StaticResource TextBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,3" />
              <TextBlock Text="{TemplateBinding Note}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type controls:PageHeader}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:PageHeader}">
          <StackPanel Margin="0,0,0,22">
            <TextBlock Text="{TemplateBinding Title}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{TemplateBinding Description}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type controls:StatusBadge}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
          <Border Background="{StaticResource AppBackground}" CornerRadius="3" Padding="7,3" HorizontalAlignment="Left">
            <TextBlock Text="{TemplateBinding Text}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type controls:EmptyState}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:EmptyState}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,26" MaxWidth="440">
            <Border Width="34" Height="34" Background="{StaticResource AppBackground}" CornerRadius="17" HorizontalAlignment="Center">
              <TextBlock Text="—" Foreground="{StaticResource MutedBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,5" />
            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource HintText}" TextAlignment="Center" HorizontalAlignment="Center" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type controls:SectionCard}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:SectionCard}">
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="18">
            <DockPanel LastChildFill="True">
              <ContentPresenter ContentSource="Header" DockPanel.Dock="Top" TextElement.FontSize="15" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextBrush}" Margin="0,0,0,15" />
              <ContentPresenter ContentSource="Content" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
