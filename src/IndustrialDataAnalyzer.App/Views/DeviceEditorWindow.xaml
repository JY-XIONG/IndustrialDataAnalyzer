<Window x:Class="IndustrialDataAnalyzer.App.Views.DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Width="840" Height="700" MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" ShowInTaskbar="False">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility" /></Window.Resources>
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock Text="{Binding ErrorText}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
        <Button Content="保存设备" Command="{Binding SaveCommand}" Padding="16,7" IsDefault="True" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
        <GroupBox Header="基本信息" Margin="0,0,0,12" Padding="12">
          <StackPanel>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,8,10"><TextBlock Text="设备名称 *" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="8,0,0,10"><TextBlock Text="设备编号 *" /><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,8,10"><TextBlock Text="设备类型" /><ComboBox ItemsSource="{Binding DeviceKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind, Mode=TwoWay}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="8,0,0,10"><TextBlock Text="备注" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
            </UniformGrid>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="串口通信配置" Margin="0,0,0,12" Padding="12" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,10,10"><TextBlock Text="COM 端口" /><ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding PortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="端口扫描" /><Button Content="刷新可用端口" Command="{Binding RefreshPortsCommand}" Style="{StaticResource OutlineButton}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="波特率" /><ComboBox ItemsSource="{Binding BaudRates}" Text="{Binding BaudRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="数据位" /><ComboBox ItemsSource="{Binding DataBitChoices}" SelectedItem="{Binding DataBits}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="停止位" /><ComboBox ItemsSource="{Binding StopBitChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StopBits}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="校验位" /><ComboBox ItemsSource="{Binding ParityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Parity}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="流控方式" /><ComboBox ItemsSource="{Binding FlowChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FlowControl}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="编码" /><ComboBox ItemsSource="{Binding Encodings}" Text="{Binding EncodingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="报文结束符" /><TextBox Text="{Binding Terminator, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" ToolTip="例如 \n 或 \r\n" /></StackPanel>
            </UniformGrid>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="模拟设备配置" Margin="0,0,0,12" Padding="12" Visibility="{Binding IsSimulator, Converter={StaticResource BoolToVisibility}}">
          <UniformGrid Columns="4">
            <StackPanel Margin="0,0,10,10"><TextBlock Text="测量类型" /><ComboBox ItemsSource="{Binding Measurements}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Measurement}" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="最小值" /><TextBox Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="最大值" /><TextBox Text="{Binding MaximumText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="间隔（毫秒）" /><TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
          </UniformGrid>
        </GroupBox>
        <GroupBox Header="数据解析配置" Padding="12">
          <StackPanel>
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,10,10"><TextBlock Text="解析方式" /><ComboBox ItemsSource="{Binding ParserModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ParserMode}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="字段名称" /><TextBox Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="单位" /><TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="分隔符" /><TextBox Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="字段序号（从 0 开始）" /><TextBox Text="{Binding FieldIndexText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
              <StackPanel Margin="0,0,10,10"><TextBlock Text="捕获组" /><TextBox Text="{Binding CaptureGroup, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
            </UniformGrid>
            <TextBlock Text="正则表达式" /><TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
            <TextBlock Text="文本数值直接解析整个报文；分隔符和正则表达式按上面的配置提取数值。" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
