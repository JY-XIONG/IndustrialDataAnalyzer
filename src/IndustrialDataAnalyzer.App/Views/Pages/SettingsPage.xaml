<UserControl x:Class="IndustrialDataAnalyzer.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IndustrialDataAnalyzer.App.Controls">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />
    <controls:SectionCard Header="软件基本信息" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
        <TextBlock Text="软件名称" Style="{StaticResource FieldLabel}" /><TextBlock Grid.Column="1" Text="{Binding Info.Name}" />
        <TextBlock Grid.Row="1" Text="软件版本" Style="{StaticResource FieldLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Info.Version}" />
        <TextBlock Grid.Row="2" Text="运行环境" Style="{StaticResource FieldLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Info.EnvironmentName}" />
      </Grid>
    </controls:SectionCard>
    <controls:SectionCard Header="本机目录" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="数据存储目录" Style="{StaticResource FieldLabel}" />
        <TextBlock Text="{Binding Info.DataDirectory}" TextWrapping="Wrap" Margin="0,7,0,16" />
        <TextBlock Text="日志目录" Style="{StaticResource FieldLabel}" />
        <TextBlock Text="{Binding Info.LogsDirectory}" TextWrapping="Wrap" Margin="0,7,0,0" />
      </StackPanel>
    </controls:SectionCard>
    <controls:SectionCard Header="关于软件">
      <StackPanel>
        <TextBlock Text="通用工业设备数据采集与分析软件" FontWeight="SemiBold" />
        <TextBlock Text="当前为 V1.0 第一阶段基础框架。设备通信、数据存储、分析与报表功能将按开发计划逐步接入。" Style="{StaticResource HintText}" Margin="0,9,0,0" />
      </StackPanel>
    </controls:SectionCard>
  </StackPanel>
</UserControl>
