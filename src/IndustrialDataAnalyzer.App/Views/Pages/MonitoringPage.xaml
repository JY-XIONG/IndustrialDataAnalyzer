<UserControl x:Class="IndustrialDataAnalyzer.App.Views.Pages.MonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IndustrialDataAnalyzer.App.Controls">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />
    <controls:SectionCard Header="监测对象" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="设备" Style="{StaticResource FieldLabel}" /><TextBlock Text="未选择设备" Margin="0,8,0,0" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="测量指标" Style="{StaticResource FieldLabel}" /><TextBlock Text="未选择指标" Margin="0,8,0,0" /></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="设备状态" Style="{StaticResource FieldLabel}" /><controls:StatusBadge Text="未连接" Margin="0,8,0,0" /></StackPanel>
      </Grid>
    </controls:SectionCard>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <controls:MetricCard Title="当前测量值" Value="—" Note="暂无实时数据" Margin="0,0,12,0" />
      <controls:MetricCard Grid.Column="1" Title="上限阈值" Value="—" Note="尚未配置" Margin="0,0,12,0" />
      <controls:MetricCard Grid.Column="2" Title="下限阈值" Value="—" Note="尚未配置" />
    </Grid>
    <controls:SectionCard Header="实时曲线" MinHeight="310">
      <controls:EmptyState Title="暂无曲线数据" Message="实时曲线将在监测功能接入后显示。" />
    </controls:SectionCard>
  </StackPanel>
</UserControl>
