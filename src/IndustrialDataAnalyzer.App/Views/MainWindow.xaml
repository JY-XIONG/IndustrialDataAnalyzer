<Window x:Class="IndustrialDataAnalyzer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IndustrialDataAnalyzer.App.Controls"
        Title="通用工业设备数据采集与分析软件" Width="1440" Height="900"
        MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <DataTemplate x:Key="NavigationItemTemplate">
      <Button Style="{StaticResource NavigationButton}" AutomationProperties.Name="{Binding Title}"
              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding}" ToolTip="{Binding Title}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          <TextBlock Text="{Binding Title}" FontSize="13"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="74" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="32" Height="32" Background="{StaticResource PrimaryBrush}" CornerRadius="4" Margin="0,0,10,0">
              <TextBlock Text="▥" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="工业数据分析" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="INDUSTRIAL ANALYZER" FontFamily="Segoe UI" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,16">
          <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />
          <TextBlock Text="第一阶段 · 基础框架" Style="{StaticResource HintText}" Margin="8,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,14">
            <TextBlock Text="工作台" Style="{StaticResource FieldLabel}" Margin="12,6,0,5" />
            <ItemsControl ItemsSource="{Binding WorkspaceItems}" ItemTemplate="{StaticResource NavigationItemTemplate}" />
            <TextBlock Text="设备与采集" Style="{StaticResource FieldLabel}" Margin="12,20,0,5" />
            <ItemsControl ItemsSource="{Binding DeviceItems}" ItemTemplate="{StaticResource NavigationItemTemplate}" />
            <TextBlock Text="数据中心" Style="{StaticResource FieldLabel}" Margin="12,20,0,5" />
            <ItemsControl ItemsSource="{Binding DataItems}" ItemTemplate="{StaticResource NavigationItemTemplate}" />
            <TextBlock Text="系统管理" Style="{StaticResource FieldLabel}" Margin="12,20,0,5" />
            <ItemsControl ItemsSource="{Binding SystemItems}" ItemTemplate="{StaticResource NavigationItemTemplate}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
        <DockPanel LastChildFill="True">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <controls:StatusBadge Text="尚未连接设备" Margin="0,0,14,0" />
            <TextBlock Text="{Binding ApplicationInfo.Version}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontFamily="Segoe UI" />
          </StackPanel>
          <TextBlock Text="{Binding CurrentPage.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ContentControl Content="{Binding CurrentPage}" Margin="28,26,28,30" />
      </ScrollViewer>
      <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
        <DockPanel VerticalAlignment="Center">
          <TextBlock Text="基础框架就绪" Style="{StaticResource HintText}" DockPanel.Dock="Left" />
          <TextBlock Text="设备接入与数据存储将在后续阶段提供" Style="{StaticResource HintText}" HorizontalAlignment="Right" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
