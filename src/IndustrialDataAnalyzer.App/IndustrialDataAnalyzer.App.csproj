<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>IndustrialDataAnalyzer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IndustrialDataAnalyzer.Core/IndustrialDataAnalyzer.Core.csproj" />
    <ProjectReference Include="../IndustrialDataAnalyzer.Services/IndustrialDataAnalyzer.Services.csproj" />
    <ProjectReference Include="../IndustrialDataAnalyzer.Infrastructure/IndustrialDataAnalyzer.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
